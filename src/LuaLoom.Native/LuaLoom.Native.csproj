<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>LuaLoom.Native</RootNamespace>
    <LuaNativeRid Condition="'$(LuaNativeRid)' == ''">$([System.Runtime.InteropServices.RuntimeInformation]::RuntimeIdentifier)</LuaNativeRid>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LuaLoom.Core" />
    <InternalsVisibleTo Include="LuaLoom.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="LuaLoom.Native.LuaVersionAttribute">
      <_Parameter1>$(LuaVersion)</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)../../artifacts/native/$(LuaNativeRid)/lualoom.*"
             Link="%(Filename)%(Extension)"
             CopyToOutputDirectory="Always"
             Condition="Exists('$(MSBuildThisFileDirectory)../../artifacts/native/$(LuaNativeRid)')" />
  </ItemGroup>

  <Target Name="ValidateLuaVersion" BeforeTargets="Build"
          Condition="'$(LuaVersion)' != '53' and '$(LuaVersion)' != '54' and '$(LuaVersion)' != '55'">
    <Error Text="Unsupported LuaVersion '$(LuaVersion)'. Supported: 53, 54, 55." />
  </Target>

</Project>
